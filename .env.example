# Supabase Configuration
# Get these values from your Supabase project settings > API

VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Example:
# VITE_SUPABASE_URL=https://abcdefghijklmn.supabase.co
# VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Optional — every VITE_* value is embedded in the public client bundle, so
# never put a secret here. Spotify and Groq keys are Edge Function secrets
# (`supabase secrets set`, see README step 5), not VITE_* variables.
# Show the AI setlist features once the groq-chat function has GROQ_API_KEY (not a secret).
# VITE_AI_FEATURES=true
# Push notifications (docs/setup/push-notifications.md). The public VAPID key from
# `npm run vapid-keys` (public by design; the private half is an Edge Function secret).
# VITE_VAPID_PUBLIC_KEY=
# Show the Notifications settings (off by default until the Phase 1 device checklist passes; not a secret).
# Per device instead: localStorage.bandmate_flag_push = "1"
# VITE_PUSH_NOTIFICATIONS=true
